*.swp
*~

# Build artifacts (track execution/ source; ignore cargo output)
execution/target/
target/
build/
*.d
*.rlib
deps/

# Local Codex Security bulk-scan artifacts (outside commit)
security-scans/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
