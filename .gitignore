# Large data / experiment artifacts / local vault (see LIMEN_VAULT_DIR)
/data/
data/
*.jsonl
*.csv
*.parquet
runs/

# Binary blobs (except committed wire golden fixtures)
*.bin
!wire/fixtures/
!wire/fixtures/**

